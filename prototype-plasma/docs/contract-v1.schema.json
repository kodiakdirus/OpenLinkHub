{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlinkhub.local/schema/contract-v1.json",
  "title": "OpenLinkHub contract 1.0 document",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "revision", "data"],
  "properties": {
    "apiVersion": {"const": "1.0"},
    "kind": {"enum": ["service", "capabilities", "snapshot", "command-result"]},
    "revision": {"type": "integer", "minimum": 1},
    "telemetryRevision": {"type": "integer", "minimum": 1},
    "data": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"kind": {"const": "snapshot"}},
        "required": ["kind"]
      },
      "then": {
        "required": ["telemetryRevision"],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "service",
              "system",
              "devices",
              "coolingProfiles",
              "scheduler",
              "displays",
              "dashboard",
              "lcdAssets",
              "lcdProfiles"
            ],
            "properties": {
              "service": {"type": "object"},
              "system": {"type": "object"},
              "devices": {
                "type": "array",
                "items": {"$ref": "#/$defs/device"}
              },
              "coolingProfiles": {"type": "array"},
              "scheduler": {"type": "object"},
              "displays": {"type": "array"},
              "dashboard": {"type": "object"},
              "lcdAssets": {"type": "array"},
              "lcdProfiles": {"type": "array"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"enum": ["celsius", "rpm", "percent"]}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "available", "access", "operations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "available": {"type": "boolean"},
        "access": {"enum": ["read", "read-write", "unavailable"]},
        "reason": {"type": "string"},
        "operations": {
          "type": "array",
          "items": {"enum": ["read", "update-label"]},
          "uniqueItems": true
        },
        "options": {"type": "object"}
      }
    },
    "channel": {
      "type": "object",
      "required": ["id", "name", "role", "hasSpeed", "hasTemperature"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "role": {"enum": ["pump", "fan", "probe", "sensor", "channel"]},
        "hasSpeed": {"type": "boolean"},
        "hasTemperature": {"type": "boolean"},
        "speed": {"$ref": "#/$defs/measurement"},
        "temperature": {"$ref": "#/$defs/measurement"}
      }
    },
    "device": {
      "type": "object",
      "required": ["id", "product", "productId", "productType", "deviceType", "online", "hidden", "transport", "profile", "capabilities", "channels", "labelTargets"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "productId": {"type": "integer", "minimum": 0},
        "productType": {"type": "integer", "minimum": 0},
        "deviceType": {"type": "string", "minLength": 1},
        "firmware": {"type": "string"},
        "online": {"type": "boolean"},
        "hidden": {"type": "boolean"},
        "transport": {"enum": ["usb", "wireless", "receiver", "internal"]},
        "profile": {"type": "object"},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "channels": {"type": "array", "items": {"$ref": "#/$defs/channel"}},
        "labelTargets": {"type": "array", "items": {"$ref": "#/$defs/labelTarget"}},
        "battery": {"$ref": "#/$defs/measurement"},
        "lighting": {"type": "object"}
      }
    },
    "labelTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "name", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scope": {"enum": ["device", "channel"]},
        "channelId": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "label": {"type": "string", "maxLength": 64}
      }
    }
  }
}
