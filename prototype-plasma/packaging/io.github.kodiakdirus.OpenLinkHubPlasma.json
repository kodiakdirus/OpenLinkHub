{
  "app-id": "io.github.kodiakdirus.OpenLinkHubPlasma",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "base": "com.riverbankcomputing.PyQt.BaseApp",
  "base-version": "6.10",
  "command": "openlinkhub-plasma",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network"
  ],
  "modules": [
    {
      "name": "openlinkhub-plasma",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --verbose --no-deps --no-build-isolation --prefix=/app ."
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": ["build", "dist", "*.egg-info", "__pycache__", ".flatpak-builder"]
        }
      ]
    }
  ]
}
